{
  "name": "porter-staff-website",
  "version": "1.0.0",
  "description": "Porter staff tools frontend with Node/Express backend for Travel Log persistence",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sync:vite-public": "node scripts/sync-vite-public.mjs",
    "sync:lib-to-js": "node scripts/sync-lib-to-js.mjs",
    "check:lib-sync": "node scripts/check-lib-sync.mjs",
    "extract:porter-app": "python scripts/extract_porter_app.py",
    "extract:vite-styles": "python scripts/extract_styles_to_vite.py",
    "dev:client": "npm run sync:vite-public && vite --config vite-scaffold/vite.config.mjs",
    "build:client": "npm run sync:vite-public && vite build --config vite-scaffold/vite.config.mjs && node scripts/generate-precache-manifest.mjs",
    "preview:client": "vite preview --config vite-scaffold/vite.config.mjs",
    "start:built": "node server.js",
    "start:prod": "npm run build:client && node server.js",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "check:i18n": "python scripts/check-i18n.py",
    "check:ci": "npm run check:lib-sync && npm run check:i18n",
    "test:e2e:ui": "playwright test --ui",
    "vite": "vite --config vite-scaffold/vite.config.mjs",
    "vite:build": "vite build --config vite-scaffold/vite.config.mjs",
    "vite:preview": "vite preview --config vite-scaffold/vite.config.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.11"
  }
}
