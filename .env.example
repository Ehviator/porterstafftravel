# Copy to .env.local (Vite loads this automatically; never commit real secrets).

#

# Production admin modal: password is baked in at build time.

# VITE_ADMIN_PASSWORD=your-strong-secret

#

# Dev (`npm run dev:client`): if unset, admin uses a local default.

# Override for one session: in the browser console, window.__ADMIN_PASSWORD = '...'

#

# Shared admin backup API (Express). Min 16 characters.

# ADMIN_API_TOKEN=your-long-random-secret

#

# Optional: same value as VITE_ADMIN_PASSWORD. After portal admin login, POST /api/admin/login

# sets an HttpOnly cookie so pull/push do not need VITE_ADMIN_API_TOKEN in the browser bundle.

# ADMIN_PASSWORD=your-strong-secret

#

# Send Set-Cookie with Secure (HTTPS only). Omit on local HTTP.

# ADMIN_COOKIE_SECURE=1

#

# Automation / CI only: bearer still works if you set this at build time.

# VITE_ADMIN_API_TOKEN=your-long-random-secret

#

# Disable strict CSP when serving Vite dist (debugging only).

# CSP_STRICT=0

#

# Production static app: Express serves vite-scaffold/dist/ when dist/index.html exists.

# Set to 0 only to force the legacy indexTEST.html stack (no Vite build).

# USE_VITE_DIST=0

#

# Express listen port (default 3000).

# PORT=3000

